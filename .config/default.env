# Configuration data used by this repository. Every configurable value is shonw as an example below.
# This file can be overriden by writing only the needed keys in another file.

# Your custom file(s) are passed to the programs in this repository via an environment variable: LOCAL_CONFIG
# and are always applied over this file, default.env, overwriting only the values you provided.
# You can supply muliple .env files in the same format as the PATH variable (each seperated by a colon). The
# order in which you pass the file indicate the order they will be applied to override each other if the same
# values are present. Exemple of the LOCAL_CONFIG variable:

# LOCAL_CONFIG=/some/random/file1.env:/some/other/file2.env

# TIP: Only override the variables you need to, to benefit from the default ones here

###############################
## Client tool configuration ##
###############################

# Configure the location of dependencies
DIR_QNAP=@GIT_ROOT@/external/demers-qnap
DIR_SETUP=${DIR_QNAP}/external/setup
DIR_XAPI=${DIR_QNAP}/external/xapi.sh

# Log configuration
# Don't print logs on the console
LOG_CONSOLE=0
# Level INFO
LOG_LEVEL=4

# Remote connection to the XAPI API
XEN_MGT="<IP address>"
XEN_PORT=80
XEN_PWD=Password
XEN_USER=Username

# Docker configuration
CLIENT_GROUP=horizon
CLIENT_USER=prod
DEV_GROUP=dev
DEV_USER=dev

# Needs to be overriden
#SOPS_AGE_KEY_FILE="<path>"

##########################
## XCP-ng configuration ##
##########################

# XCP-ng network configuration
XEN_DNS="<IP addresses>"
XEN_GW="<IP address>"
XEN_HOST="<FQDN or IP address>"
XEN_MASK="<IP address>"
XEN_NTP="<FQDN or IP address>"

# Windows UNC/SMB example: file://my.super.hostname/data/ISO_Store
# SCP example: scp://myuser:mypassword@my.super.hostname:22/var/opt/xen/ISO_Store
XEN_ISO_LIB='<URI location where ISO files are stored>'
XEN_ISO_PWD=password
XEN_ISO_USER=Domain/username

# Parameters for VM creation
VM_NET=LAN
VM_SR="Halley Storage"
VM_TAGS=post_autostartup,pre_shutdown

# Pool configuration
POOL_NAME=pool

################################
## Network site configuration ##
################################
NETS=WAN,LAN,IoT,Camera,Guest
NET_LAN=1
NET_IoT=13
NET_Camera=14
NET_Guest=12
NET_WAN=666

NET_MTU=10000

#################################
## Fedora CoreOS configuration ##
#################################

# Ignition Configuration
IG_CA=data/ignition-pki/jeremfg.com.crt
IG_CERT=data/ignition-pki/demers-ignition-server.pem
IG_IN=data/custom.ig.in
IG_KEY=data/ignition-pki/ignition-key.pem
# Port inside the container
IG_PORT=8080
# Port exposed publicly
SERVER_PORT=8765
