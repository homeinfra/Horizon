#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Prepare for dev container
#

set -ueo pipefail

cfg_load() {
  # shellcheck disable=SC1091
  if ! source "${PREFIX}/lib/config.sh"; then
    logFatal "Failed to import config.sh"
  fi

  # Check if docker is installed
  if ! command -v docker >/dev/null; then
    logFatal "Docker is not installed. Please install it first."
  elif ! command -v semver >/dev/null; then
    logFatal "Semver is not installed. Please install it first."
  fi

  local configs config
  IFS=":" read -r -a configs <<<".config/default.env:${LOCAL_CONFIG}"
  for config in "${configs[@]}"; do
    if ! config_load "${GE_ROOT}/${config}"; then
      return 1
    fi
  done

  host_env_file="${GE_ROOT}/src/.env"

  cat >"${host_env_file}" <<EOF
# This file is generated by prepare_dev.
# Do not edit it directly.
CLIENT_GROUP=${CLIENT_GROUP}
CLIENT_USER=${CLIENT_USER}
DEV_GROUP=${DEV_GROUP}
DEV_USER=${DEV_USER}
DEV_GID=$(id -g)
DEV_UID=$(id -u)
IG_PORT=${IG_PORT}
SERVER_PORT=${SERVER_PORT}
EOF
}

main() {

  cfg_load

  # Build dependency containers
  logInfo "Building dependency containers..."
  docker compose -f "${GE_ROOT}/src/docker-compose.yml" build prod_base
  docker compose -f "${GE_ROOT}/src/docker-compose.yml" build prod

  logInfo "Ready for dev container"
}

# Global variables
if [[ -z ${LOCAL_CONFIG+x} ]]; then LOCAL_CONFIG=""; fi

###########################
###### Startup logic ######
###########################

# Get directory of this script
# https://stackoverflow.com/a/246128
GE_SOURCE=${BASH_SOURCE[0]}
while [[ -L "${GE_SOURCE}" ]]; do # resolve $GE_SOURCE until the file is no longer a symlink
  GE_ROOT=$(cd -P "$(dirname "${GE_SOURCE}")" >/dev/null 2>&1 && pwd)
  GE_SOURCE=$(readlink "${GE_SOURCE}")
  [[ ${GE_SOURCE} != /* ]] && GE_SOURCE=${GE_ROOT}/${GE_SOURCE} # if $GE_SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
GE_ROOT=$(cd -P "$(dirname "${GE_SOURCE}")" >/dev/null 2>&1 && pwd)
GE_ROOT=$(realpath "${GE_ROOT}/../..")

# Determine BPKG's global prefix
if [[ -z "${PREFIX+x}" ]]; then
  if [[ $(id -u || true) -eq 0 ]]; then
    PREFIX="/usr/local"
  else
    PREFIX="${HOME}/.local"
  fi
fi

# Import dependencies
# shellcheck disable=SC1091
if ! source "${PREFIX}/lib/slf4.sh"; then
  echo "Failed to import slf4.sh"
  exit 1
fi

if [[ -p /dev/stdin ]] && [[ -z ${BASH_SOURCE[0]} ]]; then
  logFatal "This script cannot be piped"
elif [[ ${BASH_SOURCE[0]} != "${0}" ]]; then
  logFatal "This script cannot be sourced"
else
  main "$@"
  exit $?
fi
